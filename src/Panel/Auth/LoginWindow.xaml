<!-- src/Panel/Auth/LoginWindow.xaml -->
<Window x:Class="RobloxAutoManager.Panel.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RobloxAutoManager — License Activation" 
        Height="220" Width="400" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="License Key" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,8"/>
        <TextBox x:Name="KeyBox" Grid.Row="1" Padding="8,6" FontSize="14" 
                 Background="#2D2D2D" Foreground="White" BorderBrush="#3F3F3F" Margin="0,0,0,12"/>
        
        <Button x:Name="ActivateBtn" Grid.Row="2" Content="ACTIVATE" 
                Padding="0,10" FontSize="14" FontWeight="Bold"
                Background="#0078D4" Foreground="White" BorderThickness="0"
                Click="ActivateBtn_Click"/>
        
        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#FF6B6B" 
                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>