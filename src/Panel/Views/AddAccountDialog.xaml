<!-- src/Panel/Views/AddAccountDialog.xaml -->
<Window x:Class="RobloxAutoManager.Panel.Views.AddAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Account" Height="320" Width="450" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Username" Foreground="#CCC" Margin="0,0,0,4"/>
        <TextBox x:Name="UsernameBox" Grid.Row="1" Padding="8,6" Background="#2D2D2D" 
                 Foreground="White" BorderBrush="#3F3F3F" Margin="0,0,0,12"/>
        
        <TextBlock Grid.Row="2" Text=".ROBLOSECURITY Cookie" Foreground="#CCC" Margin="0,0,0,4"/>
        <TextBox x:Name="CookieBox" Grid.Row="3" Padding="8,6" Background="#2D2D2D" 
                 Foreground="White" BorderBrush="#3F3F3F" TextWrapping="Wrap" 
                 AcceptsReturn="False" Margin="0,0,0,12"/>
        
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="ValidationStatus" Foreground="#FF9800" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click" Background="#3F3F3F" Foreground="White" BorderThickness="0"/>
            <Button x:Name="AddBtn" Content="Validate &amp; Add" Padding="16,8" Click="Add_Click" Background="#0078D4" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>