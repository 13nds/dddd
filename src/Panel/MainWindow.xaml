<Window x:Class="RobloxAutoManager.Panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RobloxAutoManager v2.0"
        Height="640" Width="1000"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding AddAccountCommand}"
                        Content="+ Add Account" Margin="0,0,8,0"/>
                <Button Command="{Binding StartWatchCommand}"
                        Content="▶ Start" Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
                <Button Command="{Binding StopWatchCommand}"
                        Content="■ Stop" Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                <Button Command="{Binding RemoveSelectedCommand}"
                        Content="Remove" Style="{StaticResource NeutralButton}"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,4,0,0">

            <TabItem x:Name="AccountsTab" Header="Accounts">
                <DataGrid x:Name="AccountGrid"
                          ItemsSource="{Binding Accounts}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="180"/>
                        <DataGridTextColumn Header="Place ID" Binding="{Binding TargetServer.PlaceId}" Width="110"/>
                        <DataGridTextColumn Header="Job ID" Binding="{Binding TargetServer.JobId}" Width="230"/>
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding State}" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="InGame">
                                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Launching">
                                                        <Setter Property="Foreground" Value="#4FC3F7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Rejoining">
                                                        <Setter Property="Foreground" Value="#FF9800"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                                        <Setter Property="Foreground" Value="#F44336"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="LicenseExpired">
                                                        <Setter Property="Foreground" Value="#FF1744"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Last Checked"
                                            Binding="{Binding LastChecked, StringFormat=HH:mm:ss}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem x:Name="LogsTab" Header="Logs"/>
            <TabItem x:Name="QuotaTab" Header="API Quota"/>
            <TabItem x:Name="SettingsTab" Header="Settings">
                <ContentControl x:Name="SettingsHost"/>
            </TabItem>

        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#1A1A1A" Padding="12,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>